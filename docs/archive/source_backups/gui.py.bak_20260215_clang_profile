        ttk.Entry(frm, textvariable=ntthal_ext_cutoff_var, width=10).grid(row=rr, column=2, sticky="w")

        btns = ttk.Frame(frm)
        btns.grid(row=rr + 1, column=0, columnspan=3, sticky="e", pady=(8, 0))
