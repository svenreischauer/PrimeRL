def _subprocess_run(*args: object, **kwargs: object) -> subprocess.CompletedProcess[str]:
    if os.name == "nt":
        flags = int(kwargs.get("creationflags", 0))
        flags |= int(getattr(subprocess, "CREATE_NO_WINDOW", 0x08000000))
        kwargs["creationflags"] = flags
    return subprocess.run(*args, **kwargs)


def _existing_default(*candidates: str) -> str:
    for c in candidates:
        if c and Path(c).exists():
            return c
    return ""


def _repo_root() -> Path:
    # gui.py -> deepprimerl -> src -> repo root (dev layout)
    return Path(__file__).resolve().parents[2]


def _deepprime_root() -> Path:
    """Resolve DeepPrime root for both dev and installed layouts.

    Dev layout:
      <repo>/src/deepprimerl/gui.py and assets in <repo>/DeepPrime
    Installed layout:
      <install>/app/src/deepprimerl/gui.py and assets in <install>/
    """
    app_root = Path(__file__).resolve().parents[2]
    candidates = [
        app_root / "DeepPrime",  # dev layout
        app_root.parent,  # installed layout (<install>/app -> <install>)
        app_root,  # fallback if app is already root
    ]
    for c in candidates:
        if (
            (c / "tools" / "bin").exists()
            and (c / "databases").exists()
            and (c / "runtime").exists()
        ):
            return c
    return app_root / "DeepPrime"


def _deepprime_path(*parts: str) -> str:
    return str(_deepprime_root() / Path(*parts))


